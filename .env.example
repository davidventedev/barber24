SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (local SQLite if empty). For Supabase, use the connection string and keep SSL on.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# Supabase Storage (S3). Create a public bucket (e.g. "media") and paste S3 credentials
# from Project Settings → Storage → S3 access keys.
# Endpoint example: https://[PROJECT_REF].supabase.co/storage/v1/s3
# Public URL domain example: [PROJECT_REF].supabase.co/storage/v1/object/public/media
# SUPABASE_S3_ENDPOINT_URL=
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=media
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_S3_CUSTOM_DOMAIN=
